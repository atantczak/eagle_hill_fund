# EHF Research Platform — required environment variables
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
# Deployed components read these from AWS Secrets Manager instead of a file.

# --- Data vendor: Financial Modeling Prep (the data tooling we wrap) ---
FMP_API_KEY=your_fmp_api_key_here

# --- AWS (results-store S3 sync, future execution/reporting) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY_ID=your_aws_secret_access_key   # NOTE: legacy code reads AWS_SECRET_ACCESS_KEY_ID (with _ID suffix)
AWS_DEFAULT_REGION=us-east-2
EHF_RESULTS_S3_BUCKET=your-results-bucket             # optional; enables ExperimentRegistry.sync()

# --- Execution: Alpaca (later phase — interface stubbed now) ---
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets       # paper by default; live URL only when explicitly promoting

# --- Optional: LLM tooling (existing integrations) ---
OPEN_AI_API_KEY=your_openai_key
